# ============================================
# VARIABLES DE ENTORNO - PET WORLD
# ============================================

# ============================================
# DESARROLLO LOCAL (backend/.env)
# ============================================
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=inventory_sales_db
DB_USER=root
DB_PASSWORD=tu_password_local
JWT_SECRET=desarrollo_secret_cambiar_en_produccion
FRONTEND_URL=http://localhost:5173

# ============================================
# RAILWAY - MYSQL (Variables automáticas)
# ============================================
# Railway proporciona estas variables automáticamente:
# MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD
#
# En tu backend en Railway, mapea las variables así:
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_DATABASE=${{MySQL.MYSQLDATABASE}}
# DB_USER=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# ============================================
# RAILWAY/HEROKU - BACKEND
# ============================================
NODE_ENV=production
# PORT=<asignado automáticamente por Railway/Heroku>
# DB_HOST=<tu-db.railway.app>
# DB_PORT=<puerto de MySQL>
# DB_DATABASE=railway
# DB_USER=<usuario de MySQL>
# DB_PASSWORD=<password de MySQL>
JWT_SECRET=<generar con: openssl rand -base64 64>
FRONTEND_URL=https://tu-frontend.vercel.app

# ============================================
# VERCEL/NETLIFY - FRONTEND
# ============================================
VITE_BACKEND_URL=https://tu-backend.railway.app
